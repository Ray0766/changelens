{
  "name": "changelens",
  "version": "0.1.0",
  "description": "Visual diff for PDFs that ordinary people can review: see exactly what text, numbers and layout changed — even after repagination.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "bin": {
    "changelens": "dist-cli/cli.js"
  },
  "files": [
    "dist-cli"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run assets && vite",
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "build": "npm run build:web && npm run build:cli",
    "build:web": "npm run assets && vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "samples": "node scripts/make-samples.mjs",
    "cli": "node src/cli/cli.ts",
    "prepare": "node scripts/build-cli.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "keywords": [
    "pdf",
    "diff",
    "compare",
    "visual-diff",
    "document-review",
    "redline",
    "pdf-diff",
    "changes"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ray0766/changelens.git"
  },
  "homepage": "https://ray0766.github.io/changelens/",
  "bugs": {
    "url": "https://github.com/Ray0766/changelens/issues"
  },
  "author": "Ray0766",
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.10"
  }
}
